{
  "name": "red-frontier-mission-mars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RED FRONTIER - MISSION MARS. Original 1-4 player cooperative Mars mission game.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server/index.js --packages=external",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "art:build": "python scripts/build_art.py",
    "art:validate": "python scripts/validate_art.py"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
